# Bắt buộc nếu bật chế độ "AI Toán - Văn" trong tab PDF -> Word (lấy miễn phí tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Tùy chọn: mã PIN nhỏ để chỉ 2 người dùng được tính năng AI (để trống nếu không cần khóa)
ACCESS_PIN=

# Tùy chọn: model Gemini dùng để đọc trang tài liệu (mặc định: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
